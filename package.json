{
    "name": "@posthog/pi",
    "version": "0.2.0",
    "description": "PostHog MCP + LLM analytics extension package for pi coding agent",
    "type": "module",
    "license": "MIT",
    "author": "PostHog",
    "keywords": [
        "pi-package",
        "posthog",
        "ai",
        "llm",
        "observability",
        "tracing",
        "analytics",
        "mcp"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PostHog/posthog-pi.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@11.7.0",
    "files": [
        "src",
        "!src/**/*.test.ts"
    ],
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@sinclair/typebox": "^0.34.49",
        "posthog-node": "^5.0.0"
    },
    "peerDependencies": {
        "@mariozechner/pi-ai": "*",
        "@mariozechner/pi-coding-agent": "*"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.0",
        "@mariozechner/pi-ai": "*",
        "@mariozechner/pi-coding-agent": "*",
        "@types/node": "^26.1.2",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.55.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src/ && oxfmt --check .",
        "lint:fix": "oxlint --fix src/ && oxfmt --write .",
        "changeset": "changeset"
    }
}
